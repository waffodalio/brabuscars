# Backend — environnement DÉVELOPPEMENT
# Valeurs par défaut, non sensibles, versionnées.
# Pour surcharger localement sans committer : back/.env.development.local
NODE_ENV=development
PORT=4000
API_PREFIX=/api
CORS_ORIGIN=http://localhost:3000
# Nombre de reverse proxies devant l'API (0 en local)
TRUST_PROXY=0

# Base de développement (créée et gérée manuellement)
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=chcarsdev
DB_PASSWORD=
DB_DATABASE=chcars_dev

# Secret de dev uniquement — ne jamais réutiliser en production
JWT_SECRET=chcars_dev_only_not_a_real_secret_change_in_prod
JWT_EXPIRES_IN=1d
