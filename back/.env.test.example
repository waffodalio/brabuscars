# Backend — environnement TEST
# Copier en `.env.test`. Base dédiée, jamais partagée avec dev/prod.
NODE_ENV=test
PORT=4001
API_PREFIX=/api
CORS_ORIGIN=http://localhost:3000
TRUST_PROXY=0

# Base de test (peut être recréée/vidée à volonté par les tests)
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=chcarstest
DB_PASSWORD=
DB_DATABASE=chcars_test

JWT_SECRET=remplacer-par-une-chaine-aleatoire-de-32-caracteres-minimum
JWT_EXPIRES_IN=1h
