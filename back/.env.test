# Backend — environnement TEST
# Valeurs par défaut, non sensibles, versionnées.
# Base dédiée, jamais partagée avec dev/prod. Surcharge : back/.env.test.local
NODE_ENV=test
PORT=4001
API_PREFIX=/api
CORS_ORIGIN=http://localhost:3000
TRUST_PROXY=0

# Base de test (peut être recréée/vidée à volonté par les tests)
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=chcarstest
DB_PASSWORD=
DB_DATABASE=chcars_test

# Secret de test uniquement
JWT_SECRET=chcars_test_only_not_a_real_secret_change_in_prod
JWT_EXPIRES_IN=1h
