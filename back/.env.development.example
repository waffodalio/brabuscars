# Backend — environnement DÉVELOPPEMENT
# Copier en `.env.development` et renseigner les valeurs locales.
NODE_ENV=development
PORT=4000
API_PREFIX=/api
CORS_ORIGIN=http://localhost:3000
# Nombre de reverse proxies devant l'API (0 en local)
TRUST_PROXY=0

# Base de développement (créée et gérée manuellement)
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=chcarsdev
DB_PASSWORD=
DB_DATABASE=chcars_dev

# 32 caractères minimum — générer avec :
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=remplacer-par-une-chaine-aleatoire-de-32-caracteres-minimum
JWT_EXPIRES_IN=1d
