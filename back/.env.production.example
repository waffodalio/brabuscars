# Backend — environnement PRODUCTION
# Copier en `.env.production` sur le serveur. Ne jamais committer le fichier réel.
NODE_ENV=production
PORT=4000
API_PREFIX=/api
# Domaine réel du frontend
CORS_ORIGIN=https://chcars.example

# Base de production
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=chcarsprod
DB_PASSWORD=
DB_DATABASE=chcars_prod

# Chaîne aléatoire longue, propre à la production
JWT_SECRET=
JWT_EXPIRES_IN=1d
