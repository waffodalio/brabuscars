# Backend — environnement PRODUCTION
# Copier en `.env.production` sur le serveur. Ne jamais committer le fichier réel.
NODE_ENV=production
PORT=4000
API_PREFIX=/api
# Domaine réel du frontend (origine exacte, sans slash final)
CORS_ORIGIN=https://chcars.example
# Nombre de reverse proxies devant l'API (ex. 1 derrière Nginx)
TRUST_PROXY=1

# Base de production
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=chcarsprod
DB_PASSWORD=
DB_DATABASE=chcars_prod

# Chaîne aléatoire longue (>= 32 caractères), propre à la production :
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN=1d
